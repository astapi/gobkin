EXPO_PUBLIC_FIREBASE_API_KEY=xxx
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=xxx
EXPO_PUBLIC_FIREBASE_PROJECT_ID=xxx
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=xxx
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=xxx
EXPO_PUBLIC_FIREBASE_APP_ID=xxx

# 開発用AIブリッジ（未設定時も開発ビルドは127.0.0.1:8787へ接続）
# Android Emulator: ws://10.0.2.2:8787/v1/game
EXPO_PUBLIC_GOBLIN_AI_BRIDGE_URL=ws://127.0.0.1:8787/v1/game
# LAN公開時のみ、ブリッジ側のGOBLIN_AI_BRIDGE_TOKENと同じ値を設定
EXPO_PUBLIC_GOBLIN_AI_BRIDGE_TOKEN=

# App Store Connect (デプロイ用)
# Apple ID（App Store Connectにログインするメールアドレス）
APPLE_ID=your-email@example.com
# App-Specific Password（https://appleid.apple.com で生成）
APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
